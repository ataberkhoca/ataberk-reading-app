{
  "appId": "com.ataberkhoca.readingskills",
  "productName": "Ilkokul Ingilizce Reading",
  "directories": {
    "buildResources": "resources"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*"
  ],
  "publish": {
    "provider": "github"
  },
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "target": "nsis",
    "icon": "assets/appIcon.ico"
  },
  "mac": {
    "category": "public.app-category.education",
    "target": "dmg"
  },
  "linux": {
    "target": ["deb", "AppImage"],
    "icon": "assets/appIcon.png",
    "category": "Education",
    "synopsis": "Hikayelerle Ingilizce okuma pratigi - ilkokul 2, 3, 4. sinif",
    "maintainer": "Ataberk Hoca <bagataberk@gmail.com>"
  }
}